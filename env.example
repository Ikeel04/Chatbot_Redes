# Clave de la API de Gemini (obtener en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo a utilizar
GEMINI_MODEL=gemini-3.6-flash

# Puerto del servidor web (host/anfitrion)
HOST_PORT=8000

# URL del servidor MCP remoto de FinAssist, desplegado en Google Cloud
# Run (ver mcp_servers/finassist/SPEC.md para instrucciones de deploy).
# Si esta variable esta definida, el host usa el servidor remoto en
# vez del local. Ejemplo real de despliegue:
# FINASSIST_REMOTE_URL=https://finassist-mcp-server-8543898875.us-central1.run.app/mcp
FINASSIST_REMOTE_URL=https://tu-deploy.example.com/mcp
