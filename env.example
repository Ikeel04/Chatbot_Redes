GEMINI_API_KEY=tu_api_key_aqui

# Modelo a utilizar
GEMINI_MODEL=gemini-3.6-flash

# Puerto del servidor web (host/anfitrion)
HOST_PORT=8000

# URL del servidor MCP remoto de FinAssist (se llena en la Parte 2)
FINASSIST_REMOTE_URL=https://tu-deploy.example.com/mcp
